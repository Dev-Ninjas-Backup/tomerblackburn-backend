# Database Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection URL (for Prisma)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Super Admin Configuration
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=admin123

# Email/SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
SMTP_FROM=noreply@bburnbuilders.com

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.bburnbuilders.com

# phpMyAdmin Configuration
PMA_HOST=postgres
PMA_PORT=5432
PMA_USER=your_postgres_user
PMA_PASSWORD=your_postgres_password

# Docker Configuration
PACKAGE_NAME=tomerblackburn-backend
FRONTEND_PACKAGE_NAME=tomerblackburn-frontend
