// General site settings (singleton - only one record)
model SiteSettings {
  id              String        @id @default(uuid())
  siteTitle       String
  siteDescription String?
  logoImageId     String?
  logoImage       FileInstance? @relation(fields: [logoImageId], references: [id])

  contactNumber String?
  contactEmail  String?

  // Social Media Links
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

