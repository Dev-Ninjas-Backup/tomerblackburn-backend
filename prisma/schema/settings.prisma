// General site settings (singleton - only one record)
model SiteSettings {
  id              String        @id @default(uuid())
  siteTitle       String
  siteDescription String?
  logoImageId     String?
  logoImage       FileInstance? @relation("SiteSettingsLogo", fields: [logoImageId], references: [id])
  guidePdfId      String?
  guidePdf        FileInstance? @relation("SiteSettingsGuide", fields: [guidePdfId], references: [id])

  contactNumber String?
  contactEmail  String?
  location      String? // Address/Location field
  address       String? // Alternative address field

  // Social Media Links
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?

  // CTA Banner Settings
  ctaBannerText    String? @default("Get Your Free Live Estimate Now!")
  ctaBannerEnabled Boolean @default(true)

  // Admin email notification settings
  notificationEmail       String?
  notifyOnNewSubmission   Boolean @default(false)

  // Site availability
  maintenanceMode Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
