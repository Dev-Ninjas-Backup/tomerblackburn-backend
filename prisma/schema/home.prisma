model HomePage {
    id        String   @id @default(uuid())
    title     String
    subTitle  String
    homeBackgroundImageId String?
    homeBackgroundImage   FileInstance? @relation(fields: [homeBackgroundImageId], references: [id])

    ourMissionTitle       String
    ourMissionSubTitle    String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ServiceStandsOut {
    id        String   @id @default(uuid())
    title     String
    description String
    imageId   String?
    image     FileInstance? @relation(fields: [imageId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model AboutUs {
    id        String   @id @default(uuid())
    title     String
    ownerInfo  String
    description String
    imageId   String?
    image     FileInstance? @relation(fields: [imageId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}