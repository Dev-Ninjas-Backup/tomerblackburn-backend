model UserPermission {
  id     String @id @default(uuid())
  userId String @unique

  submissionsView   Boolean @default(true)
  submissionsEdit   Boolean @default(false)
  submissionsDelete Boolean @default(false)

  contactsView      Boolean @default(true)
  contactsEdit      Boolean @default(false)
  contactsDelete    Boolean @default(false)

  costManagementView   Boolean @default(true)
  costManagementEdit   Boolean @default(false)
  costManagementDelete Boolean @default(false)

  projectManagementView   Boolean @default(true)
  projectManagementEdit   Boolean @default(false)
  projectManagementDelete Boolean @default(false)

  webView Boolean @default(false)
  webEdit Boolean @default(false)

  settingsView Boolean @default(true)

  dataBackupAccess Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_permissions")
}
