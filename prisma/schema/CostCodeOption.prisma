model CostCodeOption {
  id            String   @id @default(uuid())
  costCodeId    String
  optionName    String
  optionValue   String?  // Specific value like "24 inch", "Standard"
  priceModifier Decimal  @default(0) @db.Decimal(10, 2)
  finalPrice    Decimal  @db.Decimal(10, 2)
  isDefault     Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  costCode        CostCode          @relation(fields: [costCodeId], references: [id], onDelete: Cascade)
  submissionItems SubmissionItem[]

  @@index([costCodeId])
  @@index([isDefault])
  @@map("cost_code_options")
}