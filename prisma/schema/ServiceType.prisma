model ServiceType {
  id          String  @id @default(uuid())
  name        String 
  description String?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceCategories ServiceCategory[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("service_types")
}
