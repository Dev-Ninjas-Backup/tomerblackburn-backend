model Submission {
  id                   String    @id @default(uuid())
  submissionNumber     String    @unique // EST-2025-001
  bathroomTypeId       String
  
  clientName           String
  clientEmail          String
  clientPhone          String
  projectAddress       String
  zipCode              String?
  
  basePrice            Decimal   @db.Decimal(10, 2)
  additionalItemsTotal Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount          Decimal   @db.Decimal(10, 2)

  status               String    @default("PENDING") // PENDING, PROCESSING, COMPLETED
  
  projectNotes         String?
  additionalDetails    String?
  
  ipAddress            String?
  userAgent            String?
  submittedAt          DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  reviewedAt           DateTime?
  completedAt          DateTime?

  bathroomType    BathroomType       @relation(fields: [bathroomTypeId], references: [id])
  submissionItems SubmissionItem[]
  submissionMedia SubmissionMedia[]
  emailLogs       EmailLog[]

  @@index([submissionNumber])
  @@index([status])
  @@index([clientEmail])
  @@index([submittedAt])
  @@index([bathroomTypeId])
  @@map("submissions")
}

model SubmissionItem {
  id               String   @id @default(uuid())
  submissionId     String
  costCodeId       String
  selectedOptionId String?
  
  quantity         Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice        Decimal  @db.Decimal(10, 2)
  totalPrice       Decimal  @db.Decimal(10, 2)
  
  itemType         String?  // fixed, selection, toggle, user_input
  isEnabled        Boolean  @default(true)
  userInputValue   String?
  
  notes            String?
  createdAt        DateTime @default(now())

  submission     Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  costCode       CostCode        @relation(fields: [costCodeId], references: [id])
  selectedOption CostCodeOption? @relation(fields: [selectedOptionId], references: [id])

  @@index([submissionId])
  @@index([costCodeId])
  @@map("submission_items")
}

model SubmissionMedia {
  id             String   @id @default(uuid())
  submissionId   String
  fileInstanceId String
  mediaType      String
  description    String?
  displayOrder   Int      @default(0)
  uploadedAt     DateTime @default(now())

  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileInstance FileInstance @relation(fields: [fileInstanceId], references: [id])

  @@index([submissionId])
  @@index([mediaType])
  @@index([fileInstanceId])
  @@map("submission_media")
}