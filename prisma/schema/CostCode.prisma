model CostCode {
  id               String   @id @default(uuid())
  categoryId       String
  code             String   @unique // FP-D-1, FP-FL-2, etc.
  name             String
  description      String?
  basePrice        Decimal  @default(0) @db.Decimal(10, 2)
  unitType         String?  // per_lot, per_sqft, per_upgrade, per_each, per_set, fixed
  colorTag         String?  // WHITE, ORANGE, BLUE, YELLOW, GREEN
  calculationType  String?  // fixed, user_input, selection, toggle
  requiresQuantity Boolean  @default(false)
  isOptional       Boolean  @default(false)
  isActive         Boolean  @default(true)
  
  appliesToFp      Boolean  @default(false) // Four Piece
  appliesToTps     Boolean  @default(false) // Three Piece Shower
  appliesToTpt     Boolean  @default(false) // Three Piece Tub
  appliesToTp      Boolean  @default(false) // Two Piece
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category                CostCodeCategory          @relation(fields: [categoryId], references: [id])
  options                 CostCodeOption[]
  bathroomTypeCostCodes   BathroomTypeCostCode[]
  submissionItems         SubmissionItem[]

  @@index([code])
  @@index([categoryId])
  @@index([isActive])
  @@index([colorTag])
  @@map("cost_codes")
}